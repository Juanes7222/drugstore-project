# Base URL of the NestJS server. Used by:
# - GET  {VITE_API_URL}/public/plans                        (live pricing; the
#   site renders seed prices until this answers with valid data)
# - POST {VITE_API_URL}/public/licensing/checkout/create-session
#
# Leave empty to run the site without a server: prices fall back to the seed
# catalog (marked as "reference" in the UI) and the checkout dialog shows a
# configuration error instead of failing silently.
VITE_API_URL=http://localhost:3000

# Absolute origin the site is served from, with no trailing slash.
# Substituted into index.html at build time for og:url and og:image, which
# crawlers resolve as absolute URLs and read from the served HTML rather than
# from JavaScript — so it cannot be injected at runtime. Leave it empty locally.
#
# In production it must match DOMAIN_LANDING in the nginx template. An empty
# value leaves the social tags root-relative, which most crawlers ignore: the
# link then previews with no image.
VITE_SITE_URL=http://localhost:5174
