# Backoffice web app environment (copy to .env and fill in).
# Never commit the real .env file.

# Base URL of the NestJS API.
VITE_API_URL=

# Public marketing site origin. Powers the "Create account" entry point on
# the login page, which deep-links to the plan selection (#planes) where the
# signup/checkout flow lives. Leave empty to hide the button.
VITE_LANDING_URL=
