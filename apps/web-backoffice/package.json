{
  "name": "@pharmacy/web-backoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Backoffice admin panel (super-admin / owner dashboard) for the pharmacy system",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.0",
    "@mui/icons-material": "^5.17.0",
    "@mui/material": "^5.17.0",
    "@pharmacy/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "axios": "^1.12.0",
    "i18next": "^26.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": ">=19",
        "react-dom": ">=19"
      }
    }
  }
}