# Database. The server connects as pharmacy_app so PostgreSQL RLS FORCE is
# active for every tenant-scoped table (see packages/database migrations
# 20260804000002+). The pharmacy_dev login is the superuser used to run
# deployments, seeds, and ad-hoc SQL — the server must never use it in
# production.
# Seed override (runs outside RLS as the superuser):
#   DATABASE_URL=postgresql://pharmacy_dev:pharmacy_dev@localhost:5432/pharmacy_dev_db pnpm dev:db:seed
DATABASE_URL=postgresql://pharmacy_app:pharmacy_app@localhost:5432/pharmacy_dev_db

# JWT Secrets (generate random secrets for your environment)
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars

# JWT TTL (in seconds)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Redis
REDIS_URL=redis://localhost:6379

# Wompi Colombia Payment Gateway
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxx
WOMPI_ENVIRONMENT=sandbox

# Server
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Infisical (secrets manager) — used ONLY in production
# ----------------------------------------------------------------------------
# In production the app resolves secrets exclusively from Infisical using a
# Machine Identity (Universal Auth). These credentials are injected by the
# deployment platform (Kubernetes/Docker secrets), never from this file, and
# the app fails to boot if they are missing.
# Infisical values win over any other environment variable (except INFISICAL_*),
# so store the full key set documented here in the 'prod' environment.
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=prod
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_SECRET_PATH=/
#
# Development keeps using this .env file and never contacts Infisical. Set
# INFISICAL_ENABLED=true (plus the credentials above) to exercise the
# integration locally against the 'dev' Infisical environment.
# INFISICAL_ENABLED=false
#
# The secrets stored in Infisical must mirror the keys documented above
# (DATABASE_URL, JWT_*, WOMPI_*, LICENSE_TOKEN_SECRET, ...). Prisma CLI
# commands during deploys can pull them with: infisical run -- pnpm db:migrate:deploy
