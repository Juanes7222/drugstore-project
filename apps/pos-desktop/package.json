{
  "name": "@pharmacy/pos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first pharmacy POS desktop terminal (Tauri 2 + React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "cross-env SERVER_PROJECT_DIR=../server vitest run --config vitest.integration.config.ts",
    "test:int:watch": "cross-env SERVER_PROJECT_DIR=../server vitest --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && touch src-tauri/build.rs && cargo build --features wdio --manifest-path src-tauri/Cargo.toml && wdio run wdio.conf.ts",
    "test:e2e:one": "pnpm build && touch src-tauri/build.rs && cargo build --features wdio --manifest-path src-tauri/Cargo.toml && wdio run wdio.conf.ts --spec",
    "db:push": "pnpm --filter @pharmacy/database exec pnpm db:generate:local-sql",
    "db:generate": "pnpm --filter @pharmacy/database exec pnpm db:generate:local",
    "db:migrate:dev": "pnpm --filter @pharmacy/database exec pnpm db:generate:local-sql",
    "db:migrate:deploy": "pnpm --filter @pharmacy/database exec pnpm db:generate:local-sql",
    "clean": "rm -rf dist src-tauri/target"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@pharmacy/database": "workspace:*",
    "@pharmacy/shared-types": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@reduxjs/toolkit": "^2.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "buffer": "^6.0.3",
    "cmdk": "^1.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.4.2",
    "i18next": "^26.3.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "pglite-prisma-adapter": "^0.7.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "sileo": "^0.1.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "argon2": "^0.44.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "expect-webdriverio": "^6.0.1",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
