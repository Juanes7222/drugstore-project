// Shared schema fragment — included in both full and local builds.
// This file is processed by scripts/assemble-schema.mjs.

model ProductCostHistory {
  id                    String    @id
  productId             String
  product               Product   @relation(fields: [productId], references: [id])
  previousCostHistoryId String?
  previousCostHistory   ProductCostHistory? @relation("CostHistoryChain", fields: [previousCostHistoryId], references: [id])
  nextCostHistories     ProductCostHistory[] @relation("CostHistoryChain")
  cost                  Decimal   @db.Decimal(15, 2)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  changedById           String
  changedAt             DateTime
  changeReason          String?

  @@index([productId])
  @@index([productId, effectiveFrom])
}
