// Local-only schema fragment — overrides shared/inventory-adjustment.prisma for the local build.
// Strips User and PhysicalCount relations since those models don't exist in the local schema.
//
// The shared (full-build) version retains the relations for server-side query convenience.
// This file is generated by scripts/split-schema.mjs.

model InventoryAdjustmentDocument {
  id                      String          @id
  sequentialNumber        Int             @unique
  state                   AdjustmentState @default(DRAFT)
  reason                  String?
  notes                   String?
  createdAt               DateTime        @default(now())
  createdByUserId         String
  submittedForApprovalAt  DateTime?
  approvedAt              DateTime?
  approvedByUserId        String?
  approvalNotes           String?
  rejectedAt              DateTime?
  rejectedByUserId        String?
  rejectionReason         String?
  appliedAt               DateTime?
  annulledAt              DateTime?
  annulledByUserId        String?
  annulmentReason         String?
  physicalCountId         String?
}

// Single-row counter that allocates sequentialNumber for InventoryAdjustmentDocument.
// Must be duplicated here because this file overrides the shared fragment; without it
// the local Prisma client would not expose `inventoryAdjustmentCounter` and any
// `upsert` on it would throw "Cannot read properties of undefined (reading 'upsert')"
// (seen in inventory-count close flow which creates an adjustment on finalize).
model InventoryAdjustmentCounter {
  id                   String @id @default("singleton")
  lastSequentialNumber Int    @default(0)
}
