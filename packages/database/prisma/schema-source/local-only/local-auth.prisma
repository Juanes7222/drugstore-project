// LOCAL-ONLY schema fragment — local replica of the User entity for
// offline-first auth in apps/pos-desktop.
//
// This is NOT a separate identity.  It is the same User entity that exists
// on the server, replicated locally with its password verifier so the POS
// can authenticate fully offline.  The UUID is generated by the client
// (ULID/v7) and never changes — the server adopts it on first sync.
//
// The password hash uses a shared algorithm (PBKDF2-SHA-512 via Web Crypto)
// so the same credential works online and offline.  When the server detects
// a password change it increments passwordVersion, and the local replica
// invalidates its cached hash on mismatch.
//
// This file is generated by scripts/split-schema.mjs.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Synchronization status of this User record between local replica and server.
enum UserSyncStatus {
  PENDING
  SYNCED
  REJECTED
}

/// How this user authenticates locally.
/// Future: PIN could be added here if the product decides to support it.
enum CredentialMode {
  PASSWORD
}

/// Active / disabled.
enum UserStatus {
  ACTIVE
  DISABLED
}

// ---------------------------------------------------------------------------
// Model
// ---------------------------------------------------------------------------

/// A user of the pharmacy POS system.
///
/// This is the canonical identity for a person operating the terminal.
/// The same UUID is used on the server once synced.  Credentials are always
/// verified against the local hash first; the server only updates, revokes,
/// or confirms the user record.
model User {
  id                  String         @id
  username            String         @unique
  displayName         String
  role                String         // One of RoleType from @pharmacy/shared-types
  status              UserStatus     @default(ACTIVE)

  // Credential cache
  passwordHash        String         // PBKDF2-SHA-512 self-describing format
  passwordVersion     Int            @default(1)

  // Sync lifecycle
  credentialMode      CredentialMode @default(PASSWORD)
  createdLocally      Boolean        @default(false)
  syncStatus          UserSyncStatus @default(PENDING)
  syncError           String?

  // Rate limiting
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean        @default(false)

  // Timestamps
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastLoginAt         DateTime?
  deletedAt           DateTime?
}
