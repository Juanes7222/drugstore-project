// Server-only schema fragment — only included in the full build.
// Critical-event routing table. Events are always delivered inside the
// tenant that originated them, so rows are tenant-scoped.
// This file is generated by scripts/split-schema.mjs.

/// Critical notifications from server to hub/POS (product deactivation,
/// price changes, config pushes, forced sync signals).
model SyncEvent {
  id                  String     @id @default(uuid())
  subscriptionId      String
  eventType           String     // PRODUCT_DEACTIVATED | PRICE_UPDATE | CONFIG_CHANGE | FORCED_SYNC | INVOICE_RESULT_READY
  entityType          String     // Product | Client | SystemConfig | Invoice
  entityId            String
  payload             Json?
  severity            String     @default("INFO") // INFO | WARNING | CRITICAL
  sourceWorkstationId String?    // null = broadcast to all workstations
  acknowledgedAt      DateTime?
  acknowledgedById    String?
  createdAt           DateTime   @default(now())
  expiresAt           DateTime?

  @@index([subscriptionId])
  @@index([createdAt])
  @@index([sourceWorkstationId, acknowledgedAt])
  @@index([eventType, createdAt])
  @@index([expiresAt])
}

/// Record of a conflict detected during operation merge.
/// Created server-side when the hub reports a conflict resolution, or
/// when the server detects conflicting operations from different sources.
model SyncConflictLog {
  id                String   @id @default(uuid())
  subscriptionId    String
  localId           String   @unique // Client-generated idempotency key
  winningWorkstationId String
  losingWorkstationId  String
  operationType     String
  entityType        String
  entityId          String
  resolution        String   // LAST_WRITER_WINS | FIRST_WRITE_WINS | SERVER_OVERRIDE
  winningOperationUuid String
  losingOperationUuid  String
  details           Json? 
  resolvedAt        DateTime @default(now())
  uploadedAt        DateTime? // When the hub uploaded this to the server

  @@index([subscriptionId])
  @@index([resolvedAt])
  @@index([winningWorkstationId])
  @@index([entityType, entityId])
  @@index([uploadedAt])
}

/// Periodic health report from a hub about itself and its peer workstations.
/// This is operational telemetry read by the server's health aggregation
/// endpoints (global scope, no tenant restriction).
model WorkstationHeartbeat {
  id                String    @id @default(uuid())
  workstationId     String
  friendlyName      String?
  appVersion        String?
  queueDepth        Int       @default(0)
  oldestPendingAt   DateTime?
  permanentFailures Int       @default(0)
  diskSpaceMb       Int?
  lastLanSyncAt     DateTime?
  /// workstationId of the hub that reported this heartbeat.
  /// When the workstation reports itself, this equals workstationId.
  reportedBy        String
  receivedAt        DateTime  @default(now())

  @@index([workstationId, receivedAt])
  @@index([receivedAt])
  @@index([reportedBy, receivedAt])
}