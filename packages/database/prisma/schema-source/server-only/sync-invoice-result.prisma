// Server-only schema fragment — only included in the full build.
//
// Stores the DIAN transmission result for offline-generated (contingency)
// invoices so workstations can poll for their results. Each result belongs
// to the tenant that issued the invoice.
//
// This file is generated by scripts/split-schema.mjs.

model SyncInvoiceResult {
  id              String    @id
  subscriptionId  String
  invoiceId       String
  workstationId   String
  status          String    // 'AUTHORIZED' | 'REJECTED'
  cufeOfficial    String?
  dianXml         String?   @db.Text
  rejectionReason String?
  authorizedAt    DateTime?
  createdAt       DateTime  @default(now())

  @@index([subscriptionId])
  @@index([workstationId, createdAt])
  @@index([invoiceId])
  @@index([workstationId, status])
}