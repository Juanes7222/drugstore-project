// Server-only schema fragment — only included in the full build.
// Client credit payments (abonos) recorded on a POS workstation, replayed
// server-side for multi-workstation debt consistency.

model ClientCreditPayment {
  id                  String    @id
  subscriptionId      String
  sequentialNumber    Int
  clientId            String
  amount              Decimal   @db.Decimal(15, 2)
  paymentMethodId     String
  notes               String?
  createdById         String
  cashShiftId         String
  workstationId       String
  createdAt           DateTime  @default(now())
  /// Sync operationUuid that created this payment via CLIENT_CREDIT_PAYMENT
  /// replay. Used for idempotent retries.
  sourceOperationUuid String?   @unique
  sourceWorkstationId String
  sourceCreatedAt     DateTime?
  /// Annulment audit trail — set when an ADMIN annuls the payment
  /// (CLIENT_CREDIT_PAYMENT_ANNULMENT). Annulled payments stop counting
  /// toward the client's debt and the shift's cash reconciliation.
  annulledAt          DateTime?
  annulledById        String?
  annulmentReason     String?

  @@index([subscriptionId])
  @@index([clientId, createdAt])
  @@index([cashShiftId])
  @@index([clientId, annulledAt])
}
