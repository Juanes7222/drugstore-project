// Server-only schema fragment — only included in the full build.
// Expiration sweep job run. The sweep executes per subscription, so the
// job row is tenant-scoped.
// This file is generated by scripts/split-schema.mjs.

model AutoExpirationJob {
  id                String    @id
  subscriptionId    String
  startedAt         DateTime
  finishedAt        DateTime?
  lotsAffected      Int?
  triggeredBy       String
  triggeredByUserId String?
  triggeredByUser   User?     @relation(fields: [triggeredByUserId], references: [id], onDelete: NoAction)
  notes             String?

  @@index([subscriptionId])
}