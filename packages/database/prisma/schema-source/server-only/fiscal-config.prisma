// Server-only schema fragment — only included in the full build.
// Fiscal issuer and tech-provider configuration. Each subscription carries
// its own NIT issuer identity, so these tables are tenant-scoped.
// This file is generated by scripts/split-schema.mjs.

model FiscalIssuerConfig {
  id                    String    @id
  subscriptionId        String
  nit                   String
  verificationDigit     String
  businessName          String
  commercialName        String?
  organizationType      String
  taxRegime             String
  taxResponsibilities   String?
  address               String
  municipality          String
  department            String
  postalCode            String?
  phone                 String?
  email                 String?
  logoUrl               String?
  updatedAt             DateTime  @updatedAt
  updatedById           String?
  updatedByUser         User?     @relation(fields: [updatedById], references: [id], onDelete: NoAction)

  certificates          FiscalCertificate[]

  @@index([subscriptionId])
  @@unique([subscriptionId, nit])
}

model TechProviderConfig {
  id                String    @id
  subscriptionId    String
  // Which party transmits this subscription's documents. Defaults to
  // DIAN_DIRECT (the historical behaviour); provider-based plans switch
  // this to ALANUBE or DATAICO at subscription time.
  providerType      FiscalProvider @default(DIAN_DIRECT)
  endpointUrl       String
  environment       String
  timeoutSeconds    Int       @default(30)
  // Pointer into the secret store for provider credentials (API keys,
  // account tokens) or the certificate bundle for DIAN_DIRECT. Follows the
  // `store:path` convention — never the credential material itself.
  credentialReference String?
  // Pointer into the secret store for the webhook HMAC secret of the
  // configured provider. Only meaningful when providerType is a webhook
  // provider; kept null for DIAN_DIRECT.
  webhookSecretReference String?
  updatedAt         DateTime  @updatedAt
  updatedById       String?
  updatedByUser     User?     @relation(fields: [updatedById], references: [id], onDelete: NoAction)

  @@index([subscriptionId])
}