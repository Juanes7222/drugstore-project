// SERVER-ONLY OVERRIDE of shared/supplier-return.prisma — only included in the full build.
// Adds the tenant column. sequentialNumber is unique per subscription.
// Keep in sync with shared/supplier-return.prisma.

model SupplierReturn {
  id                String    @id
  subscriptionId    String
  sequentialNumber  Int
  state             PurchaseReturnState @default(DRAFT)
  reason            String?
  notes             String?
  subtotal          Decimal   @db.Decimal(15, 2) @default(0)
  totalTax          Decimal   @db.Decimal(15, 2) @default(0)
  totalAmount       Decimal   @db.Decimal(15, 2) @default(0)
  createdAt         DateTime  @default(now())
  createdById       String
  updatedAt         DateTime  @updatedAt
  annulledAt        DateTime?
  annulledById      String?
  annulmentReason   String?
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  purchaseReceptionId   String?
  purchaseReception     PurchaseReception? @relation(fields: [purchaseReceptionId], references: [id])
  items             SupplierReturnItem[]

  @@index([subscriptionId])
  @@unique([subscriptionId, sequentialNumber])
  @@index([supplierId, createdAt])
  @@index([createdAt, id])
}

model SupplierReturnItem {
  id                String    @id
  subscriptionId    String
  supplierReturnId  String
  supplierReturn    SupplierReturn @relation(fields: [supplierReturnId], references: [id])
  productId         String
  lotId             String
  quantity          Int
  unitCost          Decimal   @db.Decimal(15, 2) @default(0)
  totalAmount       Decimal   @db.Decimal(15, 2) @default(0)

  @@index([subscriptionId])
  @@index([supplierReturnId, productId])
}