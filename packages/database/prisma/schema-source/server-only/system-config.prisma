// Server-only schema file — only included in the full build.
// System configuration keys. Keys are unique per subscription — each
// drugstore configures its own module-scoped parameters. A single shared
// row per tenant replaces the single-global-key model.
// This file is generated by scripts/split-schema.mjs.

model SystemConfig {
  subscriptionId String
  key               String
  value             Json
  valueType         ConfigValueType
  module            SystemModule
  description       String?
  isSensitive       Boolean   @default(false)
  updatedAt         DateTime  @updatedAt
  updatedById       String?
  updatedByUser     User?     @relation(fields: [updatedById], references: [id], onDelete: NoAction)

  @@id([subscriptionId, key])
  @@index([module])
}