// SERVER-ONLY OVERRIDE of shared/sale-item-lot.prisma — only included in the full build.
// Adds the tenant column. Keep in sync with shared/sale-item-lot.prisma.

model SaleItemLot {
  id                String    @id
  subscriptionId    String
  saleItemId        String
  saleItem          SaleItem  @relation(fields: [saleItemId], references: [id])
  lotId             String
  lot               Lot       @relation(fields: [lotId], references: [id])
  quantity          Int
  unitCostAtSale    Decimal   @db.Decimal(15, 2)

  @@index([subscriptionId])
  @@index([saleItemId])
  @@index([lotId])
}