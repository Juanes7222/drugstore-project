# =============================================================================
# Bootstrap-only configuration for production containers.
#
# SECRET POLICY (enforced by packages/infisical-config):
# NODE_ENV=production makes both apps refuse to start unless the Infisical
# Machine Identity credentials below are present. ALL other configuration is
# fetched from Infisical at boot and MUST exist in its 'prod' environment:
#
#   DATABASE_URL           postgres://pharmacy_app:<pg-password>@postgres:5432/pharmacy_prod_db
#   REDIS_URL              redis://:<redis-password>@redis:6379
#   JWT_ACCESS_SECRET      min 32 chars
#   JWT_REFRESH_SECRET     min 32 chars
#   LICENSE_TOKEN_SECRET   min 32 chars
#   UPDATE_TELEMETRY_HMAC_SECRET  min 32 chars
#   TOTP_ENCRYPTION_KEY    32-byte hex (required if TOTP login is enabled)
#   CORS_ORIGIN            https://<backoffice-origin>[,...comma-separated]
#   STORAGE_DRIVER         local | r2 — 'r2' requires every R2_* key below
#   R2_ENDPOINT            https://<account_id>.r2.cloudflarestorage.com
#   R2_BACKUPS_BUCKET      pharmacy-backups
#   R2_BACKUPS_ACCESS_KEY_ID / R2_BACKUPS_SECRET_ACCESS_KEY
#   R2_UPDATES_BUCKET      pharmacy-updates
#   R2_UPDATES_ACCESS_KEY_ID / R2_UPDATES_SECRET_ACCESS_KEY
#   BOOTSTRAP_TOKEN        remove from Infisical after first SAAS_ADMIN provisioning
#   WOMPI_* / FIREBASE_*   optional integrations
#
# <pg-password> and <redis-password> above MUST match
# ./secrets/postgres_password and ./secrets/redis_password on this host.
# Ensure .env.prod is 600 (enforced by scripts/deploy.sh).
# =============================================================================

NODE_ENV=production
TZ=America/Bogota

# --- Domains (nginx) ----------------------------------------------------------
# DOMAIN is legacy fallback; prefer DOMAIN_API. Backoffice/landing optional.
DOMAIN=api.example.com
DOMAIN_API=api.example.com
DOMAIN_BACKOFFICE=admin.example.com
DOMAIN_LANDING=www.example.com
# Let's Encrypt account email (used once by `deploy.sh init`).
ACME_EMAIL=admin@example.com

# --- Infisical Machine Identity (Universal Auth) ------------------------------
INFISICAL_CLIENT_ID=replace-me
INFISICAL_CLIENT_SECRET=replace-me
INFISICAL_PROJECT_ID=replace-me
INFISICAL_ENVIRONMENT=prod
# For self-hosted Infisical, point at your instance:
# INFISICAL_SITE_URL=https://infisical.internal.example.com
# INFISICAL_SECRET_PATH=/

# --- Plain (non-secret) application config ------------------------------------
PORT=3000
CORS_ORIGIN=https://admin.example.com
BACKUP_STORAGE_PATH=/data/backups
UPDATE_STORAGE_PATH=/data/updates
UPDATE_PUBLIC_BASE_URL=https://api.example.com
# Uncomment to expose Swagger /docs behind production TLS (e.g. staging):
# SWAGGER_ENABLED=false

# --- DB backup encryption (age, asymmetric — recommended) ----------------------
# age public key for `backups/pg-*.sql.gz.age`. Private key lives ONLY in
# ./secrets/backup_age.key on this host (600, never committed, never in Infisical).
# Generate: sudo apt install age && age-keygen -o secrets/backup_age.key
# Then copy the `age1...` public key here. Decrypt: age -d -i secrets/backup_age.key backups/pg-xxx.sql.gz.age | gunzip | psql
# If left empty, backups stay as plaintext .gz (warning logged).
# BACKUP_AGE_PUBLIC_KEY=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Offsite backup to R2 (encrypted only) ------------------------------------
# If set, `backup-db` uploads the .age file to R2 after local encrypt. Credentials
# can live in Infisical (preferred) or here in .env.prod (fallback for host cron).
# Bucket should have versioning + lifecycle (90d) enabled in Cloudflare.
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BACKUPS_BUCKET=pharmacy-backups-prod
# R2_BACKUPS_ACCESS_KEY_ID=
# R2_BACKUPS_SECRET_ACCESS_KEY=
# For host upload without Infisical, also set:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read as R2_BACKUPS_* fallback

# --- Frontend build args (Vite, build-time) -----------------------------------
# These are baked into the SPA at `docker build` time. Change requires rebuild.
VITE_API_URL=https://api.example.com
VITE_LANDING_URL=https://www.example.com
